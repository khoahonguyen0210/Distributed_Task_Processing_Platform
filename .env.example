REDIS_URL=redis://127.0.0.1:6379/0
KEY_PREFIX=taskq:

API_HOST=127.0.0.1
API_PORT=8000
ALLOWED_HOSTS=["127.0.0.1", "localhost"]
LOG_LEVEL=INFO

MAX_PAYLOAD_BYTES=16384
MAX_RESULT_BYTES=16384
MAX_ERROR_CHARS=500
MAX_BODY_BYTES=131072
LIST_SCAN_LIMIT=2000

JOB_TTL_SECONDS=86400
DEAD_LETTER_TTL_SECONDS=604800

DEFAULT_MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=1.0
RETRY_MAX_SECONDS=60.0

LEASE_SECONDS=30
HEARTBEAT_SECONDS=5
WORKER_STALE_SECONDS=15
IDLE_WAIT_SECONDS=1
MAINTENANCE_SECONDS=0.5
SHUTDOWN_GRACE_SECONDS=20
WORKER_METRICS_HOST=127.0.0.1
WORKER_METRICS_PORT=0

MAX_QUEUE_DEPTH=0
RETRY_AFTER_SECONDS=5

LLM_SERVER_URL=http://127.0.0.1:8080
LLM_CONNECT_TIMEOUT_SECONDS=3.0
LLM_READ_TIMEOUT_SECONDS=120.0
LLM_MAX_TEXT_CHARS=2000
