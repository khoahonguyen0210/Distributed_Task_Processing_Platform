# Copy to .env and change what you need. Every value here is the default.

REDIS_URL=redis://127.0.0.1:6379/0
KEY_PREFIX=taskq:

API_HOST=127.0.0.1
API_PORT=8000
# JSON list of host names the API answers to
ALLOWED_HOSTS=["127.0.0.1", "localhost"]
LOG_LEVEL=INFO

# Size limits
MAX_PAYLOAD_BYTES=16384
MAX_RESULT_BYTES=16384
MAX_ERROR_CHARS=500
MAX_BODY_BYTES=131072

# How long finished jobs are kept (seconds)
JOB_TTL_SECONDS=86400
DEAD_LETTER_TTL_SECONDS=604800

# Retries
DEFAULT_MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=1.0
RETRY_MAX_SECONDS=60.0

# Workers
LEASE_SECONDS=30
HEARTBEAT_SECONDS=5
WORKER_STALE_SECONDS=15
IDLE_WAIT_SECONDS=1
MAINTENANCE_SECONDS=0.5
SHUTDOWN_GRACE_SECONDS=20

# Docker Compose only. Put these in docker/.env, next to docker-compose.yml
WORKERS=3
WORKER_CONCURRENCY=1
